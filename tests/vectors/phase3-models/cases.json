  "root_cases": [
    {
      "name": "strict-linear-chain",
      "mode": "strict",
      "candidates": [
        {"id": "genesis", "sequence": 0, "parent": null, "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "second", "sequence": 1, "parent": "genesis", "exact_end": true, "status": "verified", "checkpoint": "complete"}
      ],
      "expected_selected": "second"
    },
    {
      "name": "interrupted-append-recovery",
      "mode": "recovery",
      "candidates": [
        {"id": "genesis", "sequence": 0, "parent": null, "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "second", "sequence": 1, "parent": "genesis", "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "third", "sequence": 2, "parent": "second", "exact_end": false, "status": "truncated", "checkpoint": "complete"}
      ],
      "expected_selected": "second"
    },
    {
      "name": "ambiguous-fork",
      "mode": "recovery",
      "candidates": [
        {"id": "genesis", "sequence": 0, "parent": null, "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "left", "sequence": 1, "parent": "genesis", "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "right", "sequence": 1, "parent": "genesis", "exact_end": false, "status": "verified", "checkpoint": "complete"}
      ],
      "expected_error": "ambiguous_fork"
    },
    {
      "name": "progress-not-root",
      "mode": "strict",
      "candidates": [
        {"id": "genesis", "sequence": 0, "parent": null, "exact_end": false, "status": "verified", "checkpoint": "complete"},
        {"id": "progress", "sequence": 1, "parent": "genesis", "exact_end": true, "status": "verified", "checkpoint": "progress"}
      ],
      "expected_error": "no_exact_end_root"
    }
  ],
